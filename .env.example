# Leave all of these unset to run in Demo Mode (no Supabase project, no API keys required).
# See README.md > Demo Mode for details.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Force Demo Mode on/off explicitly. Defaults to true when Supabase env vars above are unset.
NEXT_PUBLIC_DEMO_MODE=

# Real benefit-data providers (server-only — never prefix with NEXT_PUBLIC_).
# Leave unset to fall back to MockBenefitProvider. Get keys from:
#   MOIS_API_KEY: https://infuser.odcloud.kr (행정안전부 공공서비스(혜택) API, gov24/v3)
#   YOUTH_POLICY_API_KEY: https://www.youthcenter.go.kr (마이페이지 > OPEN API)
#   FSS_API_KEY: 금융감독원 금융상품통합비교공시 API
MOIS_API_KEY=
YOUTH_POLICY_API_KEY=
FSS_API_KEY=
